# WOYKE production application — environment template
# Copy to .env.local (never commit the filled copy) and fill each value.
# See HANDOVER.md section 5 for where each value is obtained.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings -> API / Database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Stripe (Developers -> API keys; currently test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Providers — mock/disabled until the client connects real services
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
ANALYTICS_PROVIDER=disabled

# Optional integrations, added when the client supplies credentials
# KLAVIYO_PRIVATE_API_KEY=
# POSTHOG_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
